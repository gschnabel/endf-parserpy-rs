if LO==1 [lookahead=1]:
    [MAT,1,460/ ZA, AWR, LO, 0, NG, 0]HEAD
    for i=1 to NG:
        [MAT,1,460/ E[i], 0.0, i, 0, NR, NP / tint / T ]TAB1 (table[i])
    endfor

elif LO==2 [lookahead=1]:
    [MAT,1,460/ ZA, AWR, LO, 0, 0, 0]HEAD
    [MAT,1,460/ 0.0, 0.0, 0, 0, NNF, 0 /
    {lambda[i]}{i=1 to NNF} ]LIST
endif

SEND
